{
  "description": "Open a Loupe review when Claude Code finishes",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "loupe hook stop --agent claude-code",
            "timeout": 15,
            "statusMessage": "Opening Loupe review"
          }
        ]
      }
    ]
  }
}
